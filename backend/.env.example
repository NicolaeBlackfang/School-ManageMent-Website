# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

PORT=5000
NODE_ENV=development

# MongoDB connection string (use a dedicated user with least privilege)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Use a long, random value (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed browser origins for CORS
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP (use an app-specific password, never your account password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_app_password
