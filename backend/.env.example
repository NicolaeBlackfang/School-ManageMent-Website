# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Scholaris Server (.env)

PORT=5000
NODE_ENV=development
TRUST_PROXY=1

# MongoDB
# Accepts MONGO_URI or MONGODB_URI
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
# JWT_EXPIRY=8h

# 2FA encryption (AES-256-GCM). Use a 64-hex string or base64 of 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=replace_with_a_64_hex_key

# Origins for CORS
CLIENT_URL=http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:4173
VITE_API_TARGET=http://localhost:5000

# Public app URLs (used for password-reset links)
APP_URL=http://localhost:5175
ADMIN_URL=http://localhost:5174
WEBSITE_URL=http://localhost:5175

# Payments
# 'sandbox' simulates payments (refused in production); set to a real provider key in prod
PAYMENT_PROVIDER=sandbox

# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP (optional in dev; required for password-reset emails in prod)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Scholaris <your_smtp_user>"
